    "@gltf-transform/functions": "^4.5.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "chokidar": "^5.0.0",
    "draco3dgltf": "^1.5.7",
    "fastify": "^5.12.5",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "sharp": "^0.35.5",
